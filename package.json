{
  "name": "@zennay/zssh",
  "version": "0.1.2",
  "private": true,
  "description": "Security-first remote MCP operations gateway for Linux targets.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "repo:hygiene": "node scripts/check-repo-hygiene.mjs",
    "start": "node server.mjs",
    "agent": "node agent.mjs",
    "test": "node --test",
    "mcp:claude-canary": "node mcp-claude-canary.mjs",
    "plugin:build": "python3 scripts/build-openai-plugin.py",
    "review:fixture": "node scripts/prepare-review-target.mjs",
    "review:target": "bash deploy/prepare-reviewer-target.sh",
    "gateway:public:install": "bash deploy/install-public-gateway.sh",
    "gateway:public:caddy": "node scripts/render-public-caddy.mjs",
    "gateway:public:ingress-preflight": "node scripts/check-public-ingress.mjs",
    "submission:probe": "node production-submission-probe.mjs",
    "mcp:client-token-canary": "node client-token-canary.mjs",
    "agent:init": "node scripts/create-agent-identity.mjs",
    "gateway:public:caddy:install": "bash deploy/install-public-caddy.sh",
    "gateway:public:dns": "node scripts/publish-cloudflare-dns.mjs",
    "oauth:auth0:preflight": "node scripts/check-auth0-production.mjs",
    "release:readiness": "node scripts/check-production-readiness-audit.mjs",
    "repo:main-protection:verify": "node scripts/check-main-protection.mjs",
    "repo:main-protection:status": "node scripts/check-main-protection.mjs --public-status",
    "repo:main-protection:apply": "node scripts/apply-main-protection.mjs",
    "repo:main-protection:configure": "node scripts/configure-main-protection.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "zod": "^3.25.76",
    "jose": "^6.2.12"
  },
  "bin": {
    "zssh": "bin/zssh.mjs"
  }
}
