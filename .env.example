# Secret capability token for hosted MCP clients that only support "No sign-in".
# The public URL becomes: https://host.example/mcp/<token>
ZSSH_MCP_CAPABILITY_TOKEN=replace-with-random-64-hex-token

# Static key for hosted MCP clients that support custom request headers.
# Configure the client with: x-zssh-key: <value>
ZSSH_API_KEY=replace-with-random-64-hex-key

# Bearer auth remains supported for Claude Code and existing clients.
ZSSH_DEV_BEARER_TOKEN=replace-me

# Set to 1 only when a trusted local OpenAI MCP tunnel is the sole loopback caller.
ZSSH_TRUST_LOCAL_TUNNEL=0

# Optional stable label so clients can distinguish multiple zSSH targets.
# Use letters, numbers, dots, underscores, colons, or dashes.
ZSSH_TARGET_NAME=my-linux-target

# Comma-separated filesystem roots accessible to file tools and command cwd.
# Use absolute paths that exist on the target.
ZSSH_ALLOWED_ROOTS=/home/your-user/zssh-workspace

# Raw shell stays disabled by default. full is only for an explicitly trusted/disposable target.
ZSSH_EXEC_MODE=disabled

# Hard allowlist for non-shell read-only execution. These binaries receive argv directly.
ZSSH_SAFE_PROGRAMS=uptime,whoami,id,uname,pwd,df,free

# Hard limits.
ZSSH_COMMAND_TIMEOUT_SECONDS=30
ZSSH_MAX_OUTPUT_BYTES=131072
ZSSH_MAX_FILE_BYTES=131072

PORT=8788
