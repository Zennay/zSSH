# Secret capability token for hosted MCP clients that only support "No sign-in".
# The public URL becomes: https://host.example/mcp/<token>
ZSSH_MCP_CAPABILITY_TOKEN=replace-with-random-64-hex-token

# Static key for hosted MCP clients that support custom request headers.
# Configure the client with: x-zssh-key: <value>
ZSSH_API_KEY=replace-with-random-64-hex-key

# Bearer auth remains supported for Claude Code and existing clients.
ZSSH_DEV_BEARER_TOKEN=replace-me

# Private/self-hosted revocable client-token store. Tokens themselves are never stored.
# The public OAuth profile does not use this as an auth fallback.
ZSSH_CLIENT_TOKENS_FILE=/home/your-user/.config/zssh/clients.json

# Optional private HTTPS origin used by `zssh connect` to print a capability URL.
# Use only an origin (no /mcp, credentials, query, or fragment).
ZSSH_PUBLIC_URL=https://server.example.com

# Set to 1 only when a trusted local OpenAI MCP tunnel is the sole loopback caller.
ZSSH_TRUST_LOCAL_TUNNEL=0

# private = full zSSH tool surface for trusted/private use.
# public = review-oriented surface with no generic shell/program executor advertised.
ZSSH_PLUGIN_PROFILE=private

# Optional exact plaintext token for OpenAI plugin domain verification.
# Only set this to the challenge value issued by the OpenAI submission portal.
OPENAI_APPS_CHALLENGE_TOKEN=

# Public plugin authentication. In production public mode, OAuth is the default
# and these three URLs are required. Use an established OAuth/OIDC provider.
ZSSH_PUBLIC_AUTH_MODE=oauth
ZSSH_PUBLIC_BASE_URL=https://mcp.example.com
ZSSH_OAUTH_ISSUER=https://auth.example.com
ZSSH_OAUTH_JWKS_URI=https://auth.example.com/.well-known/jwks.json
ZSSH_OAUTH_SCOPES=zssh:read,zssh:write
ZSSH_OAUTH_READ_SCOPE=zssh:read
ZSSH_OAUTH_WRITE_SCOPE=zssh:write

# Optional URLs advertised in RFC 9728 protected-resource metadata.
ZSSH_OAUTH_DOCUMENTATION_URL=https://github.com/Zennay/zSSH/blob/main/README.md
ZSSH_OAUTH_POLICY_URL=https://github.com/Zennay/zSSH/blob/main/PRIVACY.md
ZSSH_OAUTH_TERMS_URL=https://github.com/Zennay/zSSH/blob/main/TERMS.md

# Test/private compatibility only. Never set this on a public-directory deployment.
ZSSH_ALLOW_LEGACY_PUBLIC_AUTH=0

# Public targets require explicit local approval of each OAuth profile.
ZSSH_PAIRING_REQUIRED=1
# Leave empty to use ~/.config/zssh/pairings.json for the service user.
ZSSH_PAIRING_FILE=
ZSSH_PAIRING_REQUEST_TTL_SECONDS=900

# Stable opaque target ID for universal routing. Existing single-target installs may keep `local`.
# New public-gateway targets should use a generated `zt_...` identifier; never put hostnames or URLs here.
ZSSH_TARGET_ID=local

# Universal gateway only: JSON trust file containing enabled opaque target IDs
# and their Ed25519 public keys. Leave empty on legacy/single-target gateways.
ZSSH_AGENT_TRUST_FILE=

# Outbound target-agent only. The gateway URL must be an HTTPS origin.
ZSSH_AGENT_GATEWAY_URL=https://mcp.example.com
ZSSH_AGENT_PRIVATE_KEY_FILE=/home/your-user/.config/zssh/agent-ed25519.pem
# Test-only: permits http://127.0.0.1 or localhost when NODE_ENV is not production.
ZSSH_AGENT_ALLOW_HTTP_LOOPBACK=0

# Optional human-friendly public label. Avoids exposing the machine hostname.
ZSSH_TARGET_LABEL=Linux target

# Test-only escape hatch. Never set this on a public-directory deployment.
ZSSH_ALLOW_UNPAIRED_PUBLIC=0

# Public directory profile: explicit narrow, non-secret roots for public file tools.
# Production public mode refuses to start unless this is set.
ZSSH_PUBLIC_ALLOWED_ROOTS=/srv/zssh-review

# Private profile roots for owner-operated file tools and command cwd.
ZSSH_ALLOWED_ROOTS=/home/ubuntu/zennay-cloud

# Raw shell stays disabled by default. full is only for an explicitly trusted/disposable target.
ZSSH_EXEC_MODE=disabled

# Hard allowlist for non-shell read-only execution. These binaries receive argv directly.
ZSSH_SAFE_PROGRAMS=uptime,whoami,id,uname,pwd,df,free

# Private bounded Git operations use the system Git binary and never accept arbitrary Git argv.
ZSSH_GIT_BIN=/usr/bin/git

# Optional root-level systemd capabilities. These names must match the exact
# services installed through deploy/install-scoped-sudo.sh.
ZSSH_SUDO_BIN=/usr/bin/sudo
ZSSH_SYSTEMCTL_BIN=/usr/bin/systemctl
ZSSH_SYSTEMD_INSPECT_SERVICES=
ZSSH_SYSTEMD_RESTART_SERVICES=

# Hard limits.
ZSSH_COMMAND_TIMEOUT_SECONDS=30
ZSSH_MAX_OUTPUT_BYTES=131072
ZSSH_MAX_FILE_BYTES=131072

PORT=8788
