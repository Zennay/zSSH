{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "zssh": {
      "type": "streamable-http",
      "url": "__ZSSH_MCP_URL__",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "baseScopes": [
              "zssh:read",
              "zssh:write"
            ],
            "client": {
              "mode": "dcr"
            }
          }
        }
      }
    }
  }
}
