[Unit]
Description=zSSH secure remote MCP gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/zssh/gateway.env
WorkingDirectory=%h/.local/share/zssh/current
ExecStart=@NODE_BIN@ %h/.local/share/zssh/current/server.mjs
Restart=always
RestartSec=5s
TimeoutStopSec=15s
NoNewPrivileges=false
PrivateTmp=true
# Scoped sudo requires setuid on /usr/bin/sudo. This is safe only with
# exact-command sudoers grants installed by deploy/install-scoped-sudo.sh.
# RestrictSUIDSGID=true silently sets NoNewPrivs=1 in the service process.
RestrictSUIDSGID=false
LockPersonality=true
UMask=0077

[Install]
WantedBy=default.target
