[Unit]
Description=zSSH public OAuth MCP gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/zssh/public-gateway.env
WorkingDirectory=%h/.local/share/zssh-public/current
ExecStart=@NODE_BIN@ %h/.local/share/zssh-public/current/server.mjs
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target
