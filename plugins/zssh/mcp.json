{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "zssh": {
      "type": "streamable-http",
      "url": "https://zssh.zennay.nl/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "baseScopes": ["zssh:read", "zssh:write"]
          }
        }
      }
    }
  }
}
